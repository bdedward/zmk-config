&spi1 {
    status = "okay";
    cs-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;  // D1 as CS
    pinctrl-0 = <&spi1_default>;
    pinctrl-names = "default";

    display@0 {
        compatible = "ssd1306";
        reg = <0>;
        spi-max-frequency = <10000000>;
        label = "SSD1306";
        height = <64>;
        width = <128>;
    };
};
